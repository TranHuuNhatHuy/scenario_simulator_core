<?xml version="1.0" encoding="UTF-8"?>
<!--
  P0/P1: run ONLY autoware_pose_initializer from autoware_core's localization group.

  WHY THIS EXISTS

  In P0, scenario_simulator_v2 publishes /localization/kinematic_state and
  /localization/acceleration itself (concealer::AutowareUniverse, simulate_localization=true).
  Launching core's full localization group would add a second publisher on both topics
  (stop_filter and twist2accel), which corrupts everything downstream.

  But we still need pose_initializer, because it is the only thing that publishes
  /localization/initialization_state, which autoware_default_adapi relays to
  /api/localization/initialization_state, one of the three inputs concealer reduces into
  LegacyAutowareState. Without it, LegacyAutowareState is pinned at INITIALIZING forever.

  FLAGS (see config/pose_initializer_p0.param.yaml)

    gnss_enabled: false   no GnssModule, so no MapHeightFitter, which avoids the UNBOUNDED
                          wait_for_service() at map_height_fitter.cpp:100
    ndt_enabled:  false   the AUTO branch then skips ndt_->align_pose(); SSV2's LiDAR raycasts
                          entities only, never the map, so NDT has nothing to align against
    ekf_enabled:  false   no EKF trigger call (no EKF running in P0)
    stop_check:   false   no twist-buffer precondition at initialize time

  Net effect: /api/localization/initialize with a pose publishes it to /initialpose3d and
  reports INITIALIZED. Exactly what we need, using real autoware_core code.
-->
<launch>
  <arg name="pose_initializer_param_path"
       default="$(find-pkg-share autoware_core_scenario_launch)/config/pose_initializer_p0.param.yaml"/>

  <group>
    <push-ros-namespace namespace="localization"/>
    <group>
      <push-ros-namespace namespace="util"/>
      <node pkg="autoware_pose_initializer" exec="autoware_pose_initializer_node"
            name="pose_initializer" output="both">
        <param from="$(var pose_initializer_param_path)"/>
        <!-- remapped even though disabled, so the node never binds a real name -->
        <remap from="ndt_align" to="/localization/pose_estimator/ndt_align_srv"/>
        <remap from="yabloc_align" to="/localization/pose_estimator/yabloc/initializer/yabloc_align_srv"/>
        <remap from="stop_check_twist" to="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
        <remap from="gnss_pose_cov" to="/sensing/gnss/pose_with_covariance"/>
        <remap from="pose_reset" to="/initialpose3d"/>
        <remap from="ekf_trigger_node" to="/localization/pose_twist_fusion_filter/trigger_node"/>
        <remap from="ndt_trigger_node" to="/localization/pose_estimator/trigger_node"/>
        <remap from="~/pointcloud_map" to="/map/pointcloud_map"/>
        <remap from="~/partial_map_load" to="/map/get_partial_pointcloud_map"/>
        <remap from="~/vector_map" to="/map/vector_map"/>
      </node>
    </group>
  </group>
</launch>
